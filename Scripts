FPSAiming script. Used for aiming


local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Aim settings
local NORMAL_FOV = 70
local AIM_FOV = 52
local TWEEN_TIME = 0.18

local aiming = false
local equipped = false
local activeTween
local currentCamera = workspace.CurrentCamera

-- Mobile aim button
local gui = Instance.new("ScreenGui")
gui.Name = "FPSAimUI"
gui.ResetOnSpawn = false
gui.Parent = playerGui

local aimButton = Instance.new("TextButton")
aimButton.Name = "AimButton"
aimButton.Size = UDim2.fromOffset(72, 72)
aimButton.Position = UDim2.new(1, -205, 1, -205)
aimButton.BackgroundColor3 = Color3.fromRGB(25, 32, 43)
aimButton.BackgroundTransparency = 0.08
aimButton.Text = "AIM"
aimButton.TextColor3 = Color3.new(1, 1, 1)
aimButton.TextSize = 20
aimButton.Font = Enum.Font.GothamBold
aimButton.Visible = false
aimButton.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 18)
corner.Parent = aimButton

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(77, 145, 210)
stroke.Thickness = 2
stroke.Parent = aimButton

local function setAiming(state)
	aiming = state and equipped

	if activeTween then
		activeTween:Cancel()
	end

	currentCamera = workspace.CurrentCamera
	if not currentCamera then
		return
	end

	local targetFOV = aiming and AIM_FOV or NORMAL_FOV

	activeTween = TweenService:Create(
		currentCamera,
		TweenInfo.new(
			TWEEN_TIME,
			Enum.EasingStyle.Quad,
			Enum.EasingDirection.Out
		),
		{FieldOfView = targetFOV}
	)

	activeTween:Play()

	aimButton.Text = aiming and "AIM ON" or "AIM"
	aimButton.BackgroundColor3 = aiming
		and Color3.fromRGB(36, 75, 112)
		or Color3.fromRGB(25, 32, 43)
end

local function updateTool()
	local character = player.Character
	local tool = character and character:FindFirstChild("Gun")
	equipped = tool ~= nil and tool:IsA("Tool")

	aimButton.Visible = equipped and UserInputService.TouchEnabled

	if not equipped then
		setAiming(false)
	end
end

-- PC: hold right mouse button to aim
UserInputService.InputBegan:Connect(function(input, processed)
	if processed or UserInputService.TouchEnabled then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseButton2
		and equipped then
		setAiming(true)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton2
		and not UserInputService.TouchEnabled then
		setAiming(false)
	end
end)

-- Mobile: tap to toggle aim
aimButton.Activated:Connect(function()
	if equipped then
		setAiming(not aiming)
	end
end)

local function setupCharacter(character)
	character.ChildAdded:Connect(function(child)
		if child:IsA("Tool") then
			updateTool()
		end
	end)

	character.ChildRemoved:Connect(function(child)
		if child:IsA("Tool") then
			updateTool()
		end
	end)

	updateTool()
end

player.CharacterAdded:Connect(setupCharacter)

if player.Character then
	setupCharacter(player.Character)
end

workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
	currentCamera = workspace.CurrentCamera
end)

