makeLine("Top", UDim2.fromOffset(2, 8), UDim2.fromOffset(0, -7))
makeLine("Bottom", UDim2.fromOffset(2, 8), UDim2.fromOffset(0, 7))
makeLine("Left", UDim2.fromOffset(8, 2), UDim2.fromOffset(-7, 0))
makeLine("Right", UDim2.fromOffset(8, 2), UDim2.fromOffset(7, 0))

local equipped = false
local hitId = 0

local function setCrosshairColor(color)
	for _, line in ipairs(lines) do
		line.BackgroundColor3 = color
	end
end

local function updateEquipped()
	local character = player.Character
	local hasTool = character and character:FindFirstChildOfClass("Tool")

	equipped = hasTool ~= nil
	crosshair.Visible = equipped

	UserInputService.MouseIconEnabled = not equipped
	UserInputService.MouseBehavior = equipped
		and Enum.MouseBehavior.LockCenter
		or Enum.MouseBehavior.Default

	if not equipped then
		setCrosshairColor(Color3.new(1, 1, 1))
	end
end

local function setupCharacter(character)
	character.ChildAdded:Connect(function(child)
		if child:IsA("Tool") then
			updateEquipped()
		end
	end)

	character.ChildRemoved:Connect(function(child)
		if child:IsA("Tool") then
			task.defer(updateEquipped)
		end
	end)

	updateEquipped()
end

player.CharacterAdded:Connect(setupCharacter)

if player.Character then
	setupCharacter(player.Character)
else
	crosshair.Visible = false
end

hitmarkerEvent.OnClientEvent:Connect(function()
	if not equipped then
		return
	end

	hitId += 1
	local thisHit = hitId

	-- Hide the white crosshair and show a red hitmarker.
	crosshair.Visible = true
	setCrosshairColor(Color3.fromRGB(255, 40, 40))

	for _, line in ipairs(lines) do
		line.Size = UDim2.fromOffset(10, 2)
	end

	lines[1].Size = UDim2.fromOffset(2, 10)
	lines[2].Size = UDim2.fromOffset(2, 10)

	task.delay(0.18, function()
		if thisHit ~= hitId then
			return
		end

		for _, line in ipairs(lines) do
			line.Size = UDim2.fromOffset(2, 8)
		end

		lines[3].Size = UDim2.fromOffset(8, 2)
		lines[4].Size = UDim2.fromOffset(8, 2)

		setCrosshairColor(Color3.new(1, 1, 1))
		crosshair.Visible = equipped
	end)
end)

