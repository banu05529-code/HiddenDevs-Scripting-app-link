FPS Camera script - The script which is used for the first person perspective.


local Players = game:GetService("Players")

local player = Players.LocalPlayer

local function updateCamera()
	local character = player.Character

	if not character then
		return
	end

	local tool = character:FindFirstChildOfClass("Tool")

	if tool then
		player.CameraMode = Enum.CameraMode.LockFirstPerson
	else
		player.CameraMode = Enum.CameraMode.Classic
	end
end

local function setupCharacter(character)
	player.CameraMode = Enum.CameraMode.Classic

	character.ChildAdded:Connect(function(child)
		if child:IsA("Tool") then
			updateCamera()
		end
	end)

	character.ChildRemoved:Connect(function(child)
		if child:IsA("Tool") then
			updateCamera()
		end
	end)

	updateCamera()
end

player.CharacterAdded:Connect(setupCharacter)

if player.Character then
	setupCharacter(player.Character)
end


FPSWeapons script used for the shooting projectiles, sounds and animations (partially for animations)


local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local fpsSystem = ReplicatedStorage:WaitForChild("FPSSystem")
local shootEvent = fpsSystem:WaitForChild("Shoot")
local reloadEvent = fpsSystem:WaitForChild("Reload")

local equippedTool = nil
local function playGunSound(tool, soundName)
	local handle = tool:FindFirstChild("Handle")
	local sound = handle and handle:FindFirstChild(soundName)

	if sound and sound:IsA("Sound") then
		sound:Play()
	end
end
local reloading = false
local playerGui = player:WaitForChild("PlayerGui")

local function connectMobileReload()
	local gui = playerGui:WaitForChild("FPSMobileControls", 10)
	if not gui then
		return
	end

	local request = gui:WaitForChild("MobileReloadRequest", 10)
	if not request then
		return
	end

	request.Event:Connect(function()
		if equippedTool and not reloading then
			reloading = true
			playGunSound(equippedTool, "ReloadSound")
			reloadEvent:FireServer()

			task.delay(2.1, function()
				reloading = false
			end)
		end
	end)
end

task.spawn(connectMobileReload)

local function setupTool(tool)
	if not tool:IsA("Tool") then
		return
	end

	tool.Equipped:Connect(function()
		equippedTool = tool
		reloading = false
	end)

	tool.Unequipped:Connect(function()
		if equippedTool == tool then
			equippedTool = nil
			reloading = false
		end
	end)

	tool.Activated:Connect(function()
		if equippedTool ~= tool or reloading then
			return
		end

		local camera = workspace.CurrentCamera
		if not camera then
			return
		end

		local targetPosition =
			camera.CFrame.Position + camera.CFrame.LookVector * 1000
		shootEvent:FireServer(targetPosition)
	end)
end

local function setupCharacter(character)
	equippedTool = nil

	character.ChildAdded:Connect(function(child)
		if child:IsA("Tool") then
			setupTool(child)
		end
	end)

	for _, child in ipairs(character:GetChildren()) do
		if child:IsA("Tool") then
			setupTool(child)
		end
	end
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end

	if input.KeyCode == Enum.KeyCode.R and equippedTool and not reloading then
		reloading = true

		playGunSound(equippedTool, "ReloadSound")
		reloadEvent:FireServer()

		task.delay(2.1, function()
			reloading = false
		end)
	end
end)

player.CharacterAdded:Connect(setupCharacter)

if player.Character then
	setupCharacter(player.Character)
end

The FPSServer script used for the support of the systems in the server.


local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local fpsSystem = ReplicatedStorage:WaitForChild("FPSSystem")
local shootEvent = fpsSystem:WaitForChild("Shoot")
local hitmarkerEvent = fpsSystem:WaitForChild("Hitmarker")
local reloadEvent = fpsSystem:WaitForChild("Reload")
local ammoUpdateEvent = fpsSystem:WaitForChild("AmmoUpdate")

local MAGAZINE_SIZE = 30
local STARTING_RESERVE = 90
local DAMAGE = 25
local RANGE = 1000
local RELOAD_TIME = 2

local ammo = {}

local function setupPlayer(player)
	ammo[player] = {
		magazine = MAGAZINE_SIZE,
		reserve = STARTING_RESERVE,
		reloading = false,
		lastShot = 0,
	}
end

Players.PlayerAdded:Connect(setupPlayer)

Players.PlayerRemoving:Connect(function(player)
	ammo[player] = nil
end)

for _, player in ipairs(Players:GetPlayers()) do
	setupPlayer(player)
end

shootEvent.OnServerEvent:Connect(function(player, targetPosition)
	local character = player.Character
	local data = ammo[player]

	if not character or not data or data.reloading then
		return
	end

	local tool = character:FindFirstChild("Gun")
	if not tool or not tool:IsA("Tool") then
		return
	end

	if typeof(targetPosition) ~= "Vector3" then
		return
	end

	if data.magazine <= 0 then
		return
	end

	local now = os.clock()
	if now - data.lastShot < 0.12 then
		return
	end

	data.lastShot = now
	data.magazine -= 1
	shootEvent:FireClient(player)
	local handle = tool:FindFirstChild("Handle")
	local gunSound = handle and handle:FindFirstChild("GunshotSound")

	if gunSound and gunSound:IsA("Sound") then
		gunSound:Play()
	end
	ammoUpdateEvent:FireClient(player, data.magazine, data.reserve)

	local head = character:FindFirstChild("Head")
	if not head then
		return
	end

	local origin = head.Position
	local offset = targetPosition - origin

	if offset.Magnitude < 0.01 then
		return
	end

	local direction = offset.Unit * RANGE

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {character}

	local result = workspace:Raycast(origin, direction, params)
	local endPosition = origin + direction

	if result then
		endPosition = result.Position

		local hitModel = result.Instance:FindFirstAncestorOfClass("Model")
		local humanoid = hitModel and hitModel:FindFirstChildOfClass("Humanoid")

		if humanoid and humanoid.Health > 0 and hitModel ~= character then
			humanoid:TakeDamage(DAMAGE)
			hitmarkerEvent:FireClient(player)
		end
	end

	-- Thin, quick, modern bullet tracer
	local distance = (endPosition - origin).Magnitude

	if distance > 0 then
		local tracer = Instance.new("Part")
		tracer.Name = "BulletTracer"
		tracer.Anchored = true
		tracer.CanCollide = false
		tracer.CanTouch = false
		tracer.CanQuery = false
		tracer.CastShadow = false
		tracer.Material = Enum.Material.Neon
		tracer.Color = Color3.fromRGB(255, 220, 130)
		tracer.Transparency = 0.15
		tracer.Size = Vector3.new(0.025, 0.025, distance)
		tracer.CFrame = CFrame.lookAt(
			(origin + endPosition) / 2,
			endPosition
		)
		tracer.Parent = workspace

		Debris:AddItem(tracer, 0.035)
	end
end)

reloadEvent.OnServerEvent:Connect(function(player)
	local data = ammo[player]
	local character = player.Character

	if not data or not character or data.reloading then
		return
	end

	local tool = character:FindFirstChild("Gun")
	if not tool or not tool:IsA("Tool") then
		return
	end

	if data.magazine >= MAGAZINE_SIZE or data.reserve <= 0 then
		return
	end

	data.reloading = true

	task.delay(RELOAD_TIME, function()
		if not player.Parent or ammo[player] ~= data then
			return
		end

		local currentCharacter = player.Character
		local currentTool = currentCharacter
			and currentCharacter:FindFirstChild("Gun")

		if currentTool and currentTool:IsA("Tool") then
			local needed = MAGAZINE_SIZE - data.magazine
			local loaded = math.min(needed, data.reserve)

			data.magazine += loaded
			data.reserve -= loaded

			ammoUpdateEvent:FireClient(
				player,
				data.magazine,
				data.reserve
			)
		end

		data.reloading = false
	end)
end)

ammoUpdateEvent.OnServerEvent:Connect(function(player, action)
	if action ~= "Request" then
		return
	end

	local data = ammo[player]
	local character = player.Character
	local tool = character and character:FindFirstChild("Gun")

	if data and tool and tool:IsA("Tool") then
		ammoUpdateEvent:FireClient(
			player,
			data.magazine,
			data.reserve
		)
	end
end)

