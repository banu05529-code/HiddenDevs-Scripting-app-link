local function updateAmmo(mag, res)
	magazine.Text = tostring(mag)
	reserve.Text = "/ " .. tostring(res)

	local ratio = math.clamp(mag / 30, 0, 1)
	bar.Size = UDim2.new(ratio, 0, 1, 0)

	if mag <= 5 then
		magazine.TextColor3 = Color3.fromRGB(255, 90, 90)
		bar.BackgroundColor3 = Color3.fromRGB(255, 75, 75)
	elseif mag <= 10 then
		magazine.TextColor3 = Color3.fromRGB(255, 190, 85)
		bar.BackgroundColor3 = Color3.fromRGB(255, 175, 70)
	else
		magazine.TextColor3 = Color3.fromRGB(245, 249, 255)
		bar.BackgroundColor3 = Color3.fromRGB(80, 180, 255)
	end
end

